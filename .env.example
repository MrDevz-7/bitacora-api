# ─── Runtime ────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# Qué arranca este proceso: api | worker | all
RUN_MODE=all
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Nº de proxies de confianza delante de la app (0 = ninguno).
# Nunca "true": permitiría falsear la IP con X-Forwarded-For.
TRUST_PROXY=0
# Orígenes CORS permitidos, separados por coma. Vacío = ninguno.
CORS_ORIGINS=http://localhost:5173

# ─── MongoDB ────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/bitacora
# Base separada para tests de integración (nunca la de desarrollo)
MONGODB_TEST_URI=mongodb://localhost:27017/bitacora_test

# ─── Redis (dos instancias/DBs por política de memoria distinta) ──
# Cola BullMQ: requiere maxmemory-policy=noeviction
REDIS_QUEUE_URL=redis://localhost:6379/0
# Caché: puede usar allkeys-lru
REDIS_CACHE_URL=redis://localhost:6379/1
# Prefijo de las colas en Redis
QUEUE_PREFIX=bitacora

# ─── Autenticación ──────────────────────────────────────────
# OBLIGATORIO, mínimo 32 caracteres. Se deja vacío a propósito.
# Genera uno con:
#   node -p "require('node:crypto').randomBytes(48).toString('base64url')"
JWT_ACCESS_SECRET=
JWT_ISSUER=bitacora-api
JWT_AUDIENCE=bitacora-clients
# Vida del access token (segundos): 900 = 15 min
ACCESS_TOKEN_TTL_SECONDS=900
# Vida del refresh token con rotación (días)
REFRESH_TOKEN_TTL_DAYS=7
# Tope absoluto de una sesión aunque se rote (días)
REFRESH_ABSOLUTE_TTL_DAYS=30
# Cookie del refresh token: true en producción (HTTPS), false en http://localhost
COOKIE_SECURE=false